<UserControl x:Class="Ranger.View.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ranger.View"
             xmlns:viewModel="clr-namespace:Ranger.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <viewModel:LogViewModel/>
    </UserControl.DataContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <DataGrid ItemsSource="{Binding Logs}"
                  ColumnWidth="*"/>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="10"
                    VerticalAlignment="Center">
            <ComboBox Width="125"
                      Style="{StaticResource ModernComboBox}"
                      ItemsSource="{Binding LogDates}"
                      SelectedItem="{Binding SelectedLogDate}">
            </ComboBox>
            <Button Content="Refresh" Command="{Binding LoadLogDatesCommand}" Style="{StaticResource SecondaryButton}"
            Margin="10,0,0,0"/>
            <Button Content="Save as" Command="{Binding LogsSaveAsCommand}" Style="{StaticResource PrimaryButton}"
            Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
