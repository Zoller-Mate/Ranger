<UserControl x:Class="Ranger.View.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ranger.View"
             xmlns:viewModel="clr-namespace:Ranger.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <viewModel:LogViewModel/>
    </UserControl.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>
        <DataGrid ItemsSource="{Binding Logs}"
                    CanUserAddRows="False"
                    CanUserResizeColumns="False"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <ComboBox Width="100"
                        ItemsSource="{Binding LogDates}"
                        SelectedItem="{Binding SelectedLogDate}">
            </ComboBox>
            <Button Content="Refresh" Command="{Binding LoadLogDatesCommand}"/>
            <Button Content="Save as" Command="{Binding LogsSaveAsCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
