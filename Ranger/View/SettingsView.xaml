<UserControl x:Class="Ranger.View.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ranger.View"
             xmlns:viewModel="clr-namespace:Ranger.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <viewModel:SettingsViewModel/>
    </UserControl.DataContext>
    
    <Grid>
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Settings" FontSize="30" FontWeight="Bold" Margin="15"/>

            <!--StackPanel Orientation="Horizontal" Margin="10">
                <Label Content="Server Address:" VerticalAlignment="Center"/>
                <TextBox Width="400" Text="{Binding ServerAddress}"/>
            </StackPanel-->

            <StackPanel Orientation="Horizontal" Margin="10">
                <Label Content="Dev Api Key:" VerticalAlignment="Center"/>
                <TextBox Width="250" Text="{Binding DevApiKey}"/>
            </StackPanel>

            <Button Content="Save"
                    Command="{Binding SaveSettingsAsyncCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Width="70"
                    HorizontalAlignment="Left"
                    Margin="15"/>
            
        </StackPanel>
    </Grid>
</UserControl>
