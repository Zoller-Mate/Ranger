<Window x:Class="Ranger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ranger"
        mc:Ignorable="d"
        xmlns:viewModel="clr-namespace:Ranger.ViewModel"
        Title="Ranger Desktop" Height="800" Width="1500"
        MinHeight="800" MinWidth="1500"
        Icon="pack://application:,,,/Resources/RangerIcon.ico">

    <Window.DataContext>
        <viewModel:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Margin="6">
            <RadioButton Content="Log"
                      IsChecked="True"
                      Command="{Binding ShowLogViewCommand}"
                      Style="{StaticResource MenuButtonTheme}"></RadioButton>
            <RadioButton Content="Database"
						 Style="{StaticResource MenuButtonTheme}"
						 Command="{Binding ShowDatabaseViewCommand}"></RadioButton>
        </StackPanel>

        <ContentControl Grid.Column="1"
                     Margin="5"
                     Content="{Binding CurrentView}"/>
    </Grid>
</Window>
