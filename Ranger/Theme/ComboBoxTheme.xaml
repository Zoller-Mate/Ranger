<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== COLORS ===== -->
    <SolidColorBrush x:Key="ControlBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="ControlHover" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="ControlText" Color="#1F2937"/>

    <SolidColorBrush x:Key="Primary" Color="#3B82F6"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryPressed" Color="#1D4ED8"/>

    <Style x:Key="ModernComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource ControlBg}"/>
        <Setter Property="Foreground" Value="{StaticResource ControlText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>

                        <!-- 🔥 EGYETLEN BORDER -->
                        <Border x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>

                                <!-- TEXT -->
                                <ContentPresenter
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"/>

                                <!-- ARROW -->
                                <Grid Grid.Column="1">
                                    <Border Background="Transparent"/>

                                    <Path x:Name="Arrow"
                                      Data="M 0 0 L 4 4 L 8 0"
                                      Stroke="#6B7280"
                                      StrokeThickness="2"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- CLICK AREA -->
                        <ToggleButton x:Name="ToggleButton"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>

                        <!-- DROPDOWN -->
                        <Popup x:Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">

                            <Border Margin="0,4,0,0"
                                Background="White"
                                BorderBrush="{StaticResource ControlBorder}"
                                BorderThickness="1"
                                CornerRadius="6">

                                <ScrollViewer MaxHeight="300">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <!-- HOVER -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder"
                                Property="Background"
                                Value="{StaticResource ControlHover}"/>
                        </Trigger>

                        <!-- OPEN -->
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="MainBorder"
                                Property="BorderBrush"
                                Value="{StaticResource Primary}"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>